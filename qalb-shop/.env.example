# Copy to .env and adjust. Never commit real secrets.

# SQLite for local dev (path is relative to prisma/schema.prisma).
# PostgreSQL example: postgresql://user:password@localhost:5432/qalb?schema=public
DATABASE_URL="file:./dev.db"

# Public origin of the app. Used for CSRF origin checks and reset links.
APP_URL="http://localhost:3000"

# Where uploaded product images are stored (outside /public so they are served by the API).
UPLOAD_DIR="./uploads"

# bcrypt cost factor (10-14). Lower only in tests.
BCRYPT_COST="12"

# debug | info | warn | error | silent
LOG_LEVEL="info"

# Dev only: return the password reset link in the API response (no email provider wired up).
# Must stay "false" in production.
EXPOSE_DEV_RESET_LINK="false"

# Seed accounts (used by `npm run db:seed`). Change before seeding any shared database.
SEED_ADMIN_EMAIL="admin@qalb.test"
SEED_ADMIN_PASSWORD="Admin#12345"
SEED_USER_EMAIL="user@qalb.test"
SEED_USER_PASSWORD="User#12345"
